{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://cricket-auction-backend-dtzw.onrender.com/api/:match*"
    },
    {
      "source": "/socket.io/:match*",
      "destination": "https://cricket-auction-backend-dtzw.onrender.com/socket.io/:match*"
    },
    {
      "source": "/((?!api|socket.io).*)",
      "destination": "/index.html"
    }
  ]
}
